# ==========================================================
# BRYZA SYSTEM - TEMPLATE DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==========================================================

# 1. Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anonima_publica
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_privada

# 2. URLs da Aplicação
NEXT_PUBLIC_APP_URL=https://bryza.com.br
NEXT_PUBLIC_SITE_URL=https://bryza.com.br
NEXT_PUBLIC_META_PIXEL_ID=2102937713973469

# Geocodificação de endereços no mapa (pode apontar para uma instância própria)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Bryza/1.0 (+https://bryza.com.br)

# Link do grupo fechado do WhatsApp do pré-lançamento Zelo (opcional)
NEXT_PUBLIC_ZELO_WHATSAPP_GROUP_URL=

# 3. Domínio Interno
INTERNAL_USER_DOMAIN=usuarios.bryza.internal

# 4. Segredos de Segurança e Criptografia
REFERRAL_IP_HASH_SECRET=seu_segredo_para_hash_de_ip
REFERRAL_COOKIE_SECRET=seu_segredo_para_cookies

# 5. Configuração Regional
TZ=America/Sao_Paulo

# Mercado Pago checkout (Checkout Pro legado + Checkout Brick transparente)
# Use a public HTTPS URL here. Mercado Pago does not accept localhost for
# back_urls or webhooks; a tunnel may forward this URL to localhost:3000.
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_APP_URL=
# Use false durante o rollout para manter o Checkout Pro como fallback.
MERCADO_PAGO_TRANSPARENT_CHECKOUT_ENABLED=false

# Web Push (gere o par uma unica vez com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notificacoes@bryza.com.br
